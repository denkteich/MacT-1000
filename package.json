{
  "name": "mact1000",
  "productName": "MacT-1000",
  "version": "1.8.9",
  "description": "Terminal-Client für macOS und Windows: Lokale Shell, SSH, Telnet, Serielle Konsole, RDP, SCP-Dateiübertragung, TFTP-/FTP-/HTTP-/SFTP-Server – mit Split-Panes, Multi-Input und Multi-Paste",
  "main": "src/main.js",
  "author": "Harald Thomas",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/fix-permissions.js",
    "dist:mac": "electron-builder --mac zip --arm64 --x64",
    "dist:win": "electron-builder --win portable nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "dist:setup": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "serialport": "^13.0.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.0",
    "resedit": "^3.1.0"
  },
  "build": {
    "appId": "de.mact1000.app",
    "productName": "MacT-1000",
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@serialport/**"
    ],
    "files": [
      "src/**",
      "renderer/**",
      "package.json",
      "!test/**",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/cpu-features/**",
      "!node_modules/**/*.map",
      "!node_modules/@xterm/**/*.mjs",
      "!node_modules/@serialport/bindings-cpp/prebuilds/{android,linux}-*/**"
    ],
    "afterPack": "scripts/after-pack.js",
    "copyright": "Copyright © 2026 Harald Thomas",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "protocols": [
      {
        "name": "MacT-1000",
        "schemes": [
          "mact1000"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "MacT-1000 startet RDP-Clients. / MacT-1000 launches RDP clients.",
        "NSLocalNetworkUsageDescription": "MacT-1000 verbindet sich per SSH/Telnet mit Geräten im lokalen Netzwerk und stellt auf Wunsch TFTP-, FTP-, HTTP- und SFTP-Server bereit. / MacT-1000 connects to devices on the local network via SSH/Telnet and can provide TFTP, FTP, HTTP and SFTP servers."
      },
      "extraResources": [
        {
          "from": "build/bin",
          "to": "bin"
        }
      ],
      "files": [
        "src/**",
        "renderer/**",
        "package.json",
        "!test/**",
        "!scripts/**",
        "!beispiele/**",
        "!README.md",
        "!README.en.md",
        "!build/**",
        "!node_modules/node-pty/prebuilds/win32-*/**",
        "!node_modules/@serialport/bindings-cpp/prebuilds/win32-*/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "files": [
        "src/**",
        "renderer/**",
        "package.json",
        "!test/**",
        "!scripts/**",
        "!beispiele/**",
        "!README.md",
        "!build/**",
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/@serialport/bindings-cpp/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/win32-arm64/**",
        "!node_modules/@serialport/bindings-cpp/prebuilds/win32-{arm64,ia32}/**"
      ]
    },
    "portable": {
      "artifactName": "MacT-1000-${version}-portable.exe",
      "unpackDirName": false
    },
    "nsis": {
      "artifactName": "MacT-1000-${version}-setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MacT-1000",
      "uninstallDisplayName": "MacT-1000 ${version}",
      "license": "LICENSE",
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  }
}
